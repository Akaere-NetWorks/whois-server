# Configuration for the whois-server systemd unit.
#
# Installed as /etc/default/whois-server by the .deb and as
# /etc/sysconfig/whois-server by the .rpm; the unit reads whichever exists.
#
# This file is sourced by systemd as an EnvironmentFile, so it is NOT a shell
# script: no command substitution, no expansion, no export. Each line is a plain
# KEY=value pair. Restart after editing:
#
#     systemctl restart whois-server
#
# Note that the daemon itself never reads a .env file — only real process
# environment variables, which is exactly what this file becomes.

# ---------------------------------------------------------------------------
# Command-line flags
# ---------------------------------------------------------------------------
# Appended verbatim to the ExecStart command and word-split on whitespace.
# See `whois-server --help` or README.md for the full flag list.
#
# Common edits:
#   --port 4343              run WHOIS unprivileged (then drop CAP_NET_BIND_SERVICE)
#   --web-port 9999          dashboard / REST API port
#   --host 127.0.0.1         bind loopback only, for use behind a reverse proxy
#   --max-connections 200    concurrent WHOIS connection ceiling
#   --debug                  debug-level logging
WHOIS_SERVER_ARGS=

# ---------------------------------------------------------------------------
# Integration credentials
# ---------------------------------------------------------------------------
# All optional. When unset, the corresponding query suffix degrades to an
# explanatory response rather than failing startup.

#IPINFO_TOKEN=
#IPINFO_API_TOKEN=
#STEAM_API_KEY=
#OMDB_API_KEY=
#CURSEFORGE_API_KEY=
#PIXIV_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Telemetry export (off unless TELEMETRY_ENABLED=true)
# ---------------------------------------------------------------------------
#TELEMETRY_ENABLED=true
#TELEMETRY_ENDPOINT=
#TELEMETRY_BEARER_TOKEN=
