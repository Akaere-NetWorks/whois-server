<!--
  Native plugin system (Phase 6) — real replacement for the deleted Lua/mlua sandbox (see plan.md's
  locked-in decision). Feature-gated the same way WhoisServer.Services.Dn42 proved out in Phase 3:
  <Compile Remove> alone yields a genuinely empty assembly when Feature_Plugins=false, no
  <PackageReference> needs conditional exclusion since this project has no third-party deps beyond
  a BCL-adjacent logging abstraction package.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup Condition="'$(Feature_Plugins)' != 'true'">
    <Compile Remove="**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhoisServer.Core\WhoisServer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

</Project>
